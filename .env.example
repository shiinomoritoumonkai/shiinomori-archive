# このファイルを .env にコピーして、値を埋める（.env は Git の管理外。チャットに貼らない）
# GitHub では Environment「production」の Secrets に、同じ名前で入れる（docs/SETUP.md）

# サイトの合言葉（12 文字以上。開発中は仮の値でよい）
SITE_PASSWORD=

# サービスアカウントの鍵 JSON を base64 にして 1 行にしたもの
#   macOS: base64 -i ~/Downloads/xxxx.json | tr -d '\n' | pbcopy  → ここに貼る
GOOGLE_SERVICE_ACCOUNT_KEY_B64=

# Drive のルートフォルダ ID（URL の folders/ の後ろの文字列）
DRIVE_ARCHIVE_ROOT_ID=
DRIVE_MAP_ROOT_ID=

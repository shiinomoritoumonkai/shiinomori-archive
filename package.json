{
  "name": "shiinomori-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "VITE_PHOTO_SOURCE=local vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/fixtures/generate.ts",
    "ingest": "node --env-file-if-exists=.env scripts/ingest/cli.ts",
    "check:public": "node scripts/check-public.ts",
    "crypto:rotate": "node scripts/crypto-rotate.ts",
    "e2e:prepare": "pnpm fixtures && SITE_PASSWORD=fixture-password-1234 node scripts/ingest/cli.ts build --from fixtures/listing.json && VITE_PHOTO_SOURCE=local vite build",
    "dev:drive": "vite"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@googleapis/drive": "^27.1.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
